{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git commit *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-check.sh\" commit",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking whether CLAUDE.md needs updating..."
          },
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/claude-md-check.sh\" push",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Checking CLAUDE.md is committed..."
          }
        ]
      }
    ]
  }
}
